{
  "name": "bishop-cookbook",
  "private": true,
  "description": "Skills for agents running under Bishop, and the tests for their scripts.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
